# ==========================================
# OpsPulse Environment Configuration
# ==========================================

# 1. Groq Cloud API (Free at https://console.groq.com)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b

# 2. Supabase PostgreSQL & pgvector (Free at https://supabase.com)
# Optional. Use the exact connection string from Supabase; URL-encode special
# characters in the password (for example, @ becomes %40). Leave blank for local development.
SUPABASE_POSTGRES_URL=

# 3. Langfuse Observability (Free at https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 4. GitHub MCP Server Configuration (Free Personal Access Token at github.com/settings/tokens)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here
TARGET_GITHUB_REPO=octocat/Hello-World

# 5. Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
